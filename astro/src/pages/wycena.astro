  }
  .wz__intro { position: relative; display: grid; gap: 20px 64px; align-items: end; }
  @media (min-width: 960px) { .wz__intro { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }

  .wz__intro h1 { font-size: clamp(2.2rem, 1.3rem + 3vw, 4rem); font-weight: 680; letter-spacing: -0.04em; line-height: 1.03; }
  .wz__intro h1 .accent { color: var(--rose); }
  .wz__lead { font-size: var(--t-lead); line-height: 1.55; color: var(--snow-muted); max-width: 42ch; }
  .wz__facts { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 10px 22px; color: var(--snow); font-weight: 540; }
  .wz__facts li { display: inline-flex; align-items: center; gap: 8px; }
  .wz__facts :global(svg) { color: var(--rose-soft); }

  /* ---------- kreator: lewa kolumna = kroki z odpowiedziami, prawa = pytanie ---------- */
  .wizard {
    --pad: clamp(22px, 4vw, 52px);
    position: relative; margin-top: clamp(36px, 4vw, 56px);
    display: grid; grid-template-columns: minmax(0, 1fr);
    background: var(--paper); color: var(--ink); border-radius: var(--r-lg);
    box-shadow: 0 30px 80px -40px rgb(0 0 0 / 0.6);
  }
  .wizard__left { display: none; }
  .wizard__right { display: flex; flex-direction: column; }
  .wizard__content { flex: 1; display: flex; flex-direction: column; padding: var(--pad); }

  @media (min-width: 1040px) {
    .wizard { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
