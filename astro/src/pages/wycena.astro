  .wizard__alt { margin-top: auto; padding-top: 40px; color: var(--ink-muted); }

  .wz__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .wz__progress { margin-bottom: 28px; }
  .wz__count { font-size: var(--t-small); font-weight: 560; color: var(--ink-muted); margin-bottom: 10px; }
