---
// Kreator wyceny: /wycena.html
// Strona docelowa dla kampanii (Meta / Google). Parametry UTM i identyfikatory kliknięć
// są zapisywane i wysyłane razem z zapytaniem (contact.php, form_type=wizard).
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/site';

// Pytania kroku 2 zależą od wybranej usługi.
const services = [
  { id: 'strona', icon: 'browser', label: 'Strona firmowa', text: 'Wizytówka albo kilka podstron o firmie i usługach.' },
  { id: 'landing', icon: 'target', label: 'Landing page', text: 'Jedna strona pod kampanię, ofertę lub zapisy.' },
  { id: 'sklep', icon: 'cart', label: 'Sklep internetowy', text: 'Sprzedaż online z płatnościami i wysyłką.' },
  { id: 'redesign', icon: 'pen', label: 'Odświeżenie strony', text: 'Masz stronę, ale wygląda staro albo nie działa.' },
  { id: 'aplikacja', icon: 'app', label: 'Aplikacja / system', text: 'Panel, rezerwacje, kalkulator, narzędzie dla firmy.' },
  { id: 'marketing', icon: 'megaphone', label: 'SEO i reklamy', text: 'Więcej klientów z Google i Facebooka.' },
];

const chapters = [
  { title: 'Usługa', hint: 'Co mam dla Ciebie zrobić' },
  { title: 'Zakres', hint: 'Szczegóły projektu' },
  { title: 'Materiały i termin', hint: 'Co już masz i kiedy startujemy' },
  { title: 'Kontakt', hint: 'Gdzie wysłać wycenę' },
];

const opt = (name: string, values: string[], type: 'radio' | 'checkbox' = 'radio') => ({ name, values, type });
---
<Base
  title="Darmowa wycena strony internetowej | WebCanvas"
  description="Odpowiedz na kilka pytań o stronę, sklep albo kampanię. Dostaniesz orientacyjną cenę od razu, a dokładną wycenę w ciągu 24 godzin. Bez zobowiązań."
  path="/wycena.html"
>
  <section class="wz" aria-labelledby="wz-h">
    <div class="wrap">
      <div class="wz__intro" data-enter>
        <div>
          <p class="eyebrow">Bezpłatna wycena</p>
          <h1 id="wz-h">Ile będzie kosztować <span class="accent">Twoja strona?</span></h1>
        </div>
        <div>
          <p class="wz__lead">Zaznacz, czego potrzebujesz. Orientacyjną cenę zobaczysz od razu, a dokładną wycenę wyślę w ciągu 24 godzin.</p>
          <ul class="wz__facts">
            <li><Icon name="clock" size={18} />Około 2 minuty</li>
            <li><Icon name="check" size={18} />Bez zobowiązań</li>
            <li><Icon name="star" size={18} />{company.rating} w opiniach Google</li>
          </ul>
        </div>
      </div>

      <form class="wizard on-light" action="/contact.php" method="post" novalidate data-wizard>
        <input type="hidden" name="form_type" value="wizard" />
        <input type="hidden" name="estimate" value="" />
        <input type="hidden" name="tracking" value="" />
        <div class="wz__hp" aria-hidden="true">
          <label for="wz-website">Nie wypełniaj tego pola</label>
          <input id="wz-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <!-- LEWA KOLUMNA: kroki z odpowiedziami -->
        <aside class="wizard__left" aria-label="Kroki wyceny">
          <p class="wizard__kicker">Twoja wycena</p>
          <ol class="toc">
            {chapters.map((c, i) => (
              <li class="toc__item" data-toc={i}>
                <button class="toc__btn" type="button" data-goto={i} disabled>
                  <span class="toc__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="toc__body">
                    <span class="toc__title">{c.title}</span>
                    <span class="toc__sum" data-sum={i} data-hint={c.hint}>{c.hint}</span>
                  </span>
                  <span class="toc__edit">Zmień</span>
                </button>
              </li>
            ))}
          </ol>
          <p class="wizard__alt">Wolisz porozmawiać?<br /><a class="link" href={company.phoneHref}>{company.phone}</a></p>
        </aside>

        <!-- PRAWA KOLUMNA: bieżące pytanie -->
        <div class="wizard__right">
        <div class="wizard__content" data-content>
        <div class="wz__progress">
          <p class="wz__count" aria-live="polite"><span data-step-num>1</span> / 4 · <span data-step-title>Usługa</span></p>
          <div class="wz__bar" aria-hidden="true"><span data-bar></span></div>
        </div>

        <!-- KROK 1 -->
        <fieldset class="wz__step" data-step="1">
          <legend class="wz__q">Czego potrzebujesz?</legend>
          <div class="wz__tiles">
            {services.map((s) => (
              <label class="tile">
                <input type="radio" name="service" value={s.label} data-service={s.id} required />
                <span class="tile__icon"><Icon name={s.icon} size={22} /></span>
                <span class="tile__label">{s.label}</span>
                <span class="tile__text">{s.text}</span>
              </label>
            ))}
          </div>
          <p class="wz__error" data-error></p>
        </fieldset>

        <!-- KROK 2: zakres, osobno dla każdej usługi -->
        <fieldset class="wz__step" data-step="2" hidden>
          <legend class="wz__q">Zakres projektu</legend>

          {[
            { for: 'strona redesign', q: 'Ile mniej więcej podstron?', ...opt('pages', ['Jedna (one-page)', 'Do 5', '6–15', 'Więcej niż 15', 'Nie wiem']) },
            { for: 'strona redesign landing', q: 'Co ma się znaleźć na stronie?', hint: 'Możesz zaznaczyć kilka.', ...opt('features', ['Formularz kontaktowy', 'Galeria / realizacje', 'Blog lub aktualności', 'Rezerwacje online', 'Kilka wersji językowych', 'Mapa i dojazd', 'Opinie klientów', 'Integracja z innym systemem'], 'checkbox') },
            { for: 'landing', q: 'Jaki jest cel strony?', ...opt('goal', ['Zapytania i telefony', 'Zapisy (np. na szkolenie)', 'Sprzedaż produktu', 'Pobranie materiału / e-booka', 'Inny']) },
            { for: 'sklep', q: 'Ile produktów na start?', ...opt('products', ['Do 50', '50–500', 'Ponad 500', 'Nie wiem']) },
            { for: 'sklep', q: 'Czego potrzebuje sklep?', hint: 'Możesz zaznaczyć kilka.', ...opt('features', ['Płatności online (BLIK, karty)', 'Integracja z kurierami / InPost', 'Faktury i księgowość', 'Import z hurtowni', 'Allegro', 'Kilka wersji językowych'], 'checkbox') },
            { for: 'redesign', q: 'Co jest nie tak z obecną stroną?', hint: 'Możesz zaznaczyć kilka.', ...opt('problems', ['Wygląda przestarzale', 'Źle działa na telefonie', 'Wolno się ładuje', 'Nie przynosi zapytań', 'Trudno ją edytować', 'Nie ma jej w Google'], 'checkbox') },
            { for: 'marketing', q: 'Co Cię interesuje?', hint: 'Możesz zaznaczyć kilka.', ...opt('channels', ['Pozycjonowanie w Google (SEO)', 'Wizytówka Google', 'Reklamy Google Ads', 'Reklamy na Facebooku i Instagramie', 'Jeszcze nie wiem, doradź'], 'checkbox') },
          ].map((g) => (
            <div class="wz__group" data-for={g.for}>
              <p class="wz__label">{g.q}{g.type === 'radio' && <span class="wz__req" aria-hidden="true"> *</span>}</p>
              {g.hint && <p class="wz__hint">{g.hint}</p>}
              <div class="chips" role={g.type === 'radio' ? 'radiogroup' : 'group'} aria-label={g.q}>
                {g.values.map((v) => (
                  <label class="chip">
                    <input type={g.type} name={g.type === 'checkbox' ? `${g.name}[]` : g.name} value={v} data-required={g.type === 'radio' ? '' : undefined} />
                    <span>{v}</span>
                  </label>
                ))}
              </div>
            </div>
          ))}

          <div class="wz__group" data-for="redesign marketing">
            <label class="wz__label" for="wz-url">Adres obecnej strony</label>
            <input class="input" id="wz-url" name="url" type="text" inputmode="url" placeholder="np. mojafirma.pl" />
          </div>

          <div class="wz__group" data-for="aplikacja">
            <label class="wz__label" for="wz-app">Opisz krótko, co ma robić aplikacja<span class="wz__req" aria-hidden="true"> *</span></label>
            <p class="wz__hint">Kto będzie z niej korzystać i jaki problem ma rozwiązać.</p>
            <textarea class="input" id="wz-app" name="app_description" rows="5" data-required-for="aplikacja"></textarea>
          </div>
          <p class="wz__error" data-error></p>
        </fieldset>

        <!-- KROK 3 -->
        <fieldset class="wz__step" data-step="3" hidden>
          <legend class="wz__q">Materiały i termin</legend>
          <div class="wz__group" data-for="strona landing sklep redesign aplikacja">
            <p class="wz__label">Co już masz?</p>
            <p class="wz__hint">Brak materiałów to nie problem, pomogę je przygotować.</p>
            <div class="chips" role="group" aria-label="Co już masz?">
              {['Logo', 'Teksty', 'Zdjęcia', 'Domenę', 'Hosting', 'Nic z tych rzeczy'].map((v) => (
                <label class="chip"><input type="checkbox" name="materials[]" value={v} /><span>{v}</span></label>
              ))}
            </div>
          </div>
          <div class="wz__group" data-for="strona landing sklep redesign aplikacja">
            <p class="wz__label">Jaki budżet bierzesz pod uwagę?</p>
            <p class="wz__hint">Kwoty netto. Pomoże dobrać zakres do Twoich możliwości. Opcjonalnie.</p>
            <div class="chips" role="radiogroup" aria-label="Jaki budżet bierzesz pod uwagę?">
              {['2 000–3 000 zł', '3 000–5 000 zł', '5 000–8 000 zł', '8 000–12 000 zł', 'Powyżej 12 000 zł', 'Nie wiem, doradź'].map((v) => (
                <label class="chip"><input type="radio" name="budget" value={v} /><span>{v}</span></label>
              ))}
            </div>
          </div>
          {[
            { for: 'marketing', id: 'wz-budget-m', name: 'budget_monthly', q: 'Jaki budżet miesięczny bierzesz pod uwagę?', hint: 'Łącznie z budżetem na reklamy. Opcjonalnie.', suffix: 'zł / mies.' },
          ].map((b) => (
            <div class="wz__group" data-for={b.for}>
              <label class="wz__label" for={b.id}>{b.q}</label>
              <p class="wz__hint">{b.hint}</p>
              <div class="budget">
                <div class="budget__field">
                  <input class="input budget__input" id={b.id} name={b.name} type="text" inputmode="numeric" placeholder="np. 5000" maxlength="20" data-budget />
                  <span class="budget__suffix" aria-hidden="true">{b.suffix}</span>
                </div>
                <label class="chip"><input type="checkbox" name={`${b.name}_unknown`} value="Nie wiem, proszę o propozycję" data-budget-unknown /><span>Nie wiem, doradź</span></label>
              </div>
            </div>
          ))}
          <div class="wz__group">
            <p class="wz__label">Kiedy chcesz zacząć?<span class="wz__req" aria-hidden="true"> *</span></p>
            <div class="chips" role="radiogroup" aria-label="Kiedy chcesz zacząć?">
              {['Jak najszybciej', 'W ciągu miesiąca', 'Za 1–3 miesiące', 'Dopiero zbieram informacje'].map((v) => (
                <label class="chip"><input type="radio" name="timeline" value={v} data-required /><span>{v}</span></label>
              ))}
            </div>
          </div>
          <div class="wz__group">
            <label class="wz__label" for="wz-msg">Coś jeszcze, co warto wiedzieć?</label>
            <p class="wz__hint">Branża, strony, które Ci się podobają, konkurencja. Opcjonalnie.</p>
            <textarea class="input" id="wz-msg" name="message" rows="4"></textarea>
          </div>
          <p class="wz__error" data-error></p>
        </fieldset>

        <!-- KROK 4 -->
        <fieldset class="wz__step" data-step="4" hidden>
          <legend class="wz__q">Gdzie wysłać wycenę?</legend>

          <div class="estimate" data-estimate>
            <p class="estimate__label">Orientacyjnie</p>
            <p class="estimate__price" data-estimate-price></p>
            <p class="estimate__note" data-estimate-note></p>
          </div>

          <div class="wz__row">
            <div class="field">
              <label for="wz-name">Imię<span class="wz__req" aria-hidden="true"> *</span></label>
              <input class="input" id="wz-name" name="name" type="text" autocomplete="name" data-rule="name" />
              <p class="field__error" data-field-error></p>
            </div>
            <div class="field">
              <label for="wz-company">Firma</label>
              <input class="input" id="wz-company" name="company" type="text" autocomplete="organization" />
            </div>
          </div>
          <div class="wz__row">
            <div class="field">
              <label for="wz-email">E-mail<span class="wz__req" aria-hidden="true"> *</span></label>
              <input class="input" id="wz-email" name="email" type="email" autocomplete="email" data-rule="email" />
              <p class="field__error" data-field-error></p>
            </div>
            <div class="field">
              <label for="wz-phone">Telefon</label>
              <input class="input" id="wz-phone" name="phone" type="tel" autocomplete="tel" data-rule="phone" />
              <p class="field__error" data-field-error></p>
            </div>
          </div>
          <div class="wz__group">
            <p class="wz__label">Jak wolisz kontakt?</p>
            <div class="chips" role="radiogroup" aria-label="Jak wolisz kontakt?">
              {['E-mail', 'Telefon', 'Obojętnie'].map((v, i) => (
                <label class="chip"><input type="radio" name="contact_pref" value={v} checked={i === 2} /><span>{v}</span></label>
              ))}
            </div>
          </div>
          <div class="field field--check">
            <input id="wz-consent" name="consent" type="checkbox" data-rule="consent" />
            <label for="wz-consent">Wyrażam zgodę na przetwarzanie moich danych osobowych w celu przygotowania wyceny. Administratorem danych jest WebCanvas. Szczegóły w <a href="/polityka-prywatnosci.html">Polityce prywatności</a>.</label>
            <p class="field__error" data-field-error></p>
          </div>
          <p class="wz__error" data-error></p>
        </fieldset>

        <!-- PODZIĘKOWANIE -->
        <div class="wz__done" data-done hidden tabindex="-1">
          <span class="wz__done-icon"><Icon name="check" size={28} /></span>
          <h2>Dziękuję, zapytanie dotarło.</h2>
          <p>Przejrzę odpowiedzi i w ciągu 24 godzin (w dni robocze) wyślę wycenę. Jeśli coś będzie niejasne, zadzwonię albo dopytam mailowo.</p>
          <a class="btn btn--ghost" href="/realizacje.html">Zobacz realizacje <Icon name="arrow" /></a>
        </div>

        <div class="wz__nav" data-nav>
          <button class="btn btn--ghost wz__back" type="button" data-back hidden>Wstecz</button>
          <button class="btn btn--primary wz__next" type="button" data-next>Dalej <Icon name="arrow" /></button>
          <button class="btn btn--primary wz__next" type="submit" data-submit hidden>Wyślij i odbierz wycenę <Icon name="arrow" /></button>
        </div>
        <p class="wz__status" role="status" aria-live="polite" data-status></p>
        </div>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  // Orientacyjne ceny (PLN netto) spójne z cennikiem na stronie głównej.
  // Zmień tutaj, jeśli zmieni się cennik. null = wycena indywidualna.
  const PRICES = {
    pro: 3000,     // Pakiet Pro
    unique: 4000,  // Pakiet Unique
  };

  const STEP_TITLES = ['Usługa', 'Zakres', 'Materiały i termin', 'Kontakt'];
  const TRACK_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'utm_id', 'gclid', 'fbclid'];

  const form = document.querySelector<HTMLFormElement>('[data-wizard]');
  if (form) {
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('[data-step]')];
    const back = form.querySelector<HTMLButtonElement>('[data-back]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-next]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const bar = form.querySelector<HTMLElement>('[data-bar]')!;
    let current = 0;
    let started = false;

    const push = (data: Record<string, unknown>) => (window as any).dataLayer?.push(data);

    // --- śledzenie źródła (UTM, gclid, fbclid), zapamiętane na czas sesji ---
    const tracking: Record<string, string> = {};
    try { Object.assign(tracking, JSON.parse(sessionStorage.getItem('wc_utm') || '{}')); } catch {}
    const params = new URLSearchParams(location.search);
    TRACK_KEYS.forEach((k) => { const v = params.get(k); if (v) tracking[k] = v.slice(0, 200); });
    if (!tracking.landing) tracking.landing = location.pathname;
    if (!tracking.referrer && document.referrer && !document.referrer.includes(location.host)) tracking.referrer = document.referrer.slice(0, 200);
    try { sessionStorage.setItem('wc_utm', JSON.stringify(tracking)); } catch {}
    (form.elements.namedItem('tracking') as HTMLInputElement).value = Object.entries(tracking).map(([k, v]) => `${k}=${v}`).join('\n');

    const service = () => (form.querySelector<HTMLInputElement>('input[name="service"]:checked')?.dataset.service ?? '');
    const isActive = (el: Element) => {
      const group = el.closest<HTMLElement>('[data-for]');
      return !group || group.dataset.for!.split(' ').includes(service());
    };

    // pokazuje tylko pytania dla wybranej usługi; ukryte pola są wyłączone, więc nie trafiają do maila
    const applyService = () => {
      form.querySelectorAll<HTMLElement>('[data-for]').forEach((g) => {
        const on = isActive(g);
        g.hidden = !on;
        g.querySelectorAll<HTMLInputElement>('input, textarea').forEach((i) => (i.disabled = !on));
      });
    };

    const estimate = () => {
      const s = service();
      const val = (n: string) => form.querySelector<HTMLInputElement>(`input[name="${n}"]:checked:not(:disabled)`)?.value ?? '';
      if (s === 'marketing') return { price: 'Wycena indywidualna', note: 'Koszt zależy od zakresu i budżetu reklamowego. Zaproponuję plan dopasowany do Twojej firmy.' };
      if (s === 'aplikacja') return { price: `od ${fmt(PRICES.unique)} zł netto`, note: 'Aplikacje wyceniam po krótkiej rozmowie o funkcjach. Podana kwota to dolna granica.' };
      const onePage = s === 'landing' || (s === 'strona' && val('pages') === 'Jedna (one-page)');
      if (onePage) return { price: `od ${fmt(PRICES.pro)} zł netto`, note: 'Pakiet Pro: strona one-page lub landing page, wersja na telefony, podstawowe SEO.' };
      return { price: `od ${fmt(PRICES.unique)} zł netto`, note: 'Pakiet Unique: indywidualny projekt, panel do edycji treści, szkolenie z obsługi.' };
    };
    const fmt = (n: number) => n.toLocaleString('pl-PL');

    const show = (i: number) => {
      current = i;
      steps.forEach((s, n) => (s.hidden = n !== i));
      back.hidden = i === 0;
      next.hidden = i === steps.length - 1;
      submit.hidden = i !== steps.length - 1;
      form.querySelector('[data-step-num]')!.textContent = String(i + 1);
      form.querySelector('[data-step-title]')!.textContent = STEP_TITLES[i];
      bar.style.width = `${((i + 1) / steps.length) * 100}%`;
      status.textContent = '';
      if (i === steps.length - 1) {
        const e = estimate();
        form.querySelector('[data-estimate-price]')!.textContent = e.price;
        form.querySelector('[data-estimate-note]')!.textContent = e.note;
        (form.elements.namedItem('estimate') as HTMLInputElement).value = e.price;
      }
      push({ event: 'wizard_step', wizard_step: i + 1, wizard_service: service() || undefined });
    };

    const reduceMotion = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const focusStep = () => {
      const legend = steps[current].querySelector<HTMLElement>('legend')!;
      legend.tabIndex = -1;
      legend.focus({ preventScroll: true });
    };
    const scrollToForm = () => {
      const top = form.getBoundingClientRect().top + scrollY - 100;
      if (top < scrollY) scrollTo({ top, behavior: reduceMotion() ? 'auto' : 'smooth' });
    };

    // --- lewa kolumna: odpowiedzi z poprzednich kroków + powrót do nich ---
    const picked = (i: number) =>
      [...steps[i].querySelectorAll<HTMLInputElement>('input:checked:not(:disabled), input[type="text"]:not(:disabled), textarea:not(:disabled)')]
        .filter((el) => el.type !== 'text' || el.value.trim())
        .filter((el) => el.tagName !== 'TEXTAREA')
        .map((el) => el.value.trim());
    const updateToc = () => {
      form.querySelectorAll<HTMLElement>('[data-toc]').forEach((li) => {
        const i = Number(li.dataset.toc);
        li.classList.toggle('is-current', i === current);
        li.classList.toggle('is-done', i < current);
        li.querySelector<HTMLButtonElement>('button')!.disabled = i >= current;
        const sum = li.querySelector<HTMLElement>('[data-sum]')!;
        let text = i < current && i < steps.length - 1 ? picked(i).join(', ') : '';
        if (i < current && i === 1 && service() === 'aplikacja' && !text) text = 'Opis aplikacji';
        if (text.length > 90) text = text.slice(0, 88).trimEnd() + '…';
        sum.textContent = text || sum.dataset.hint!;
      });
    };

    const go = (to: number) => {
      if (to === current || to < 0 || to >= steps.length) return;
      scrollToForm();
      show(to);
      updateToc();
      focusStep();
    };

    form.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((b) => b.addEventListener('click', () => go(Number(b.dataset.goto))));

    // walidacja kroku: wymagane grupy wyboru + pola kontaktowe
    const fieldRules: Record<string, (el: HTMLInputElement) => string> = {
      name: (el) => (el.value.trim() ? '' : 'Wpisz imię.'),
      email: (el) => (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim()) ? '' : 'Wpisz adres e-mail z @, np. jan@firma.pl.'),
      phone: (el) => (!el.value.trim() || el.value.replace(/\D/g, '').length >= 9 ? '' : 'Numer wygląda na za krótki.'),
      consent: (el) => (el.checked ? '' : 'Zaznacz zgodę, żebym mógł wysłać wycenę.'),
    };
    const validate = () => {
      const step = steps[current];
      const errors: string[] = [];
      let firstBad: HTMLElement | null = null;

      const names = new Set([...step.querySelectorAll<HTMLInputElement>('[data-required]:not(:disabled), input[name="service"]')].map((i) => i.name));
      names.forEach((n) => {
        if (!step.querySelector(`input[name="${n}"]:checked`)) {
          const first = step.querySelector<HTMLInputElement>(`input[name="${n}"]`)!;
          const q = first.closest('.wz__group')?.querySelector('.wz__label')?.textContent?.replace('*', '').trim();
          errors.push(q ? `Odpowiedz na pytanie: ${q}` : 'Wybierz jedną z opcji.');
          firstBad ??= first;
        }
      });
      step.querySelectorAll<HTMLTextAreaElement>('[data-required-for]:not(:disabled)').forEach((t) => {
        if (t.value.trim().length < 10) { errors.push('Opisz krótko aplikację (kilka zdań wystarczy).'); firstBad ??= t; }
      });
      step.querySelectorAll<HTMLInputElement>('[data-rule]').forEach((el) => {
        const msg = fieldRules[el.dataset.rule!](el);
        const err = el.parentElement!.querySelector<HTMLElement>('[data-field-error]')!;
        err.textContent = msg;
        el.toggleAttribute('aria-invalid', !!msg);
        if (msg) { errors.push(msg); firstBad ??= el; }
      });

      const box = step.querySelector<HTMLElement>('[data-error]')!;
      box.textContent = errors.length && !step.querySelector('[data-rule]') ? errors[0] : '';
      if (firstBad) (firstBad as HTMLElement).focus();
      return !errors.length;
    };

    let pointer = false;
    form.addEventListener('pointerdown', () => (pointer = true));
    form.addEventListener('keydown', () => (pointer = false));

    form.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (!t.matches('[data-budget]')) return;
      // tylko cyfry, z odstępem co trzy (5 000)
      const digits = t.value.replace(/\D/g, '').slice(0, 9);
      t.value = digits ? Number(digits).toLocaleString('pl-PL') : '';
      if (digits) t.closest('.budget')!.querySelector<HTMLInputElement>('[data-budget-unknown]')!.checked = false;
    });

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (!started) { started = true; push({ event: 'wizard_start' }); }
      if (t.name === 'service') {
        applyService();
        steps[0].querySelector<HTMLElement>('[data-error]')!.textContent = '';
        // wybór usługi od razu przenosi dalej (tylko myszą/dotykiem, nie przy nawigacji strzałkami)
        if (pointer) go(1);
      }
      if (t.matches('[data-budget-unknown]') && t.checked) {
        const inp = t.closest('.budget')!.querySelector<HTMLInputElement>('[data-budget]')!;
        inp.value = '';
      }
      if (t.closest('.chips')) steps[current].querySelector<HTMLElement>('[data-error]')!.textContent = '';
      // "Nic z tych rzeczy" wyklucza pozostałe materiały
      if (t.name === 'materials[]') {
        const all = [...form.querySelectorAll<HTMLInputElement>('input[name="materials[]"]')];
        const none = all.find((i) => i.value === 'Nic z tych rzeczy')!;
        if (t === none && none.checked) all.forEach((i) => i !== none && (i.checked = false));
        else if (t !== none && t.checked) none.checked = false;
      }
    });

    next.addEventListener('click', () => { if (validate()) go(current + 1); });
    back.addEventListener('click', () => go(current - 1));

    // Enter w polu tekstowym nie wysyła formularza przed ostatnim krokiem
    form.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key === 'Enter' && t.tagName === 'INPUT' && current < steps.length - 1) { e.preventDefault(); next.click(); }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (current !== steps.length - 1 || !validate()) return;
      submit.disabled = true;
      const t = setTimeout(() => { status.dataset.state = ''; status.textContent = 'Wysyłanie…'; }, 300);
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        clearTimeout(t);
        if (res.ok && data.success !== 'false') {
          status.textContent = '';
          steps.forEach((s) => (s.hidden = true));
          form.querySelector<HTMLElement>('[data-nav]')!.hidden = true;
          form.querySelector<HTMLElement>('.wz__progress')!.hidden = true;
          const done = form.querySelector<HTMLElement>('[data-done]')!;
          done.hidden = false;
          done.focus();
          current = steps.length;
          updateToc();
          push({ event: 'form_submit', form_type: 'wizard', wizard_service: service(), ...tracking });
          push({ event: 'generate_lead', form_type: 'wizard' });
        } else {
          status.dataset.state = 'error';
          status.textContent = data.message || 'Nie udało się wysłać. Spróbuj ponownie albo napisz na kontakt@web-canvas.pl.';
        }
      } catch {
        clearTimeout(t);
        status.dataset.state = 'error';
        status.textContent = 'Brak połączenia. Spróbuj ponownie albo napisz na kontakt@web-canvas.pl.';
      } finally {
        submit.disabled = false;
      }
    });

    applyService();
    show(0);
    updateToc();
  }
</script>

<style>
  .wz {
    position: relative; overflow: hidden;
