---
// Renderuje sekcje podstron wyciągnięte ze starego serwisu (src/content/pages/*.json).
import Icon from './Icon.astro';
import Faq from './Faq.astro';
import PlanCard from './PlanCard.astro';
import ContactSection from './ContactSection.astro';
import { webPlans, hourlyRate, pricingNote } from '../data/site';

interface Props { sections: any[]; ctaMode?: 'form' | 'buttons' | 'none'; plain?: boolean }
const { sections, ctaMode = 'form', plain = false } = Astro.props;

const strip = (h = '') => h.replace(/<[^>]+>/g, '').trim();

// ostatnia sekcja z H2 to wezwanie do kontaktu -> wspólny formularz
const lastIdx = ctaMode === 'none' ? -1 : sections.map((s) => !!s.h2).lastIndexOf(true);

type Kind = 'shot' | 'facts' | 'faq' | 'pricing' | 'projects' | 'links' | 'steps' | 'cards' | 'prose' | 'cta';
function kindOf(s: any, i: number): Kind {
  if (s.type === 'shot') return 'shot';
  if (s.type === 'facts') return 'facts';
  if (i === lastIdx) return 'cta';
  if (s.plans === 'web') return 'pricing';
  const items = s.items ?? [];
  if (items.length && /pytani/i.test(s.h2 ?? '')) return 'faq';
  if (items.some((it: any) => it.price)) return 'pricing';
  if (items.some((it: any) => it.img)) return 'projects';
  if (items.length && items.every((it: any) => it.href && !it.href.startsWith('/#'))) return 'links';
  if (items.length && /krok|proces|etap|jak pracujemy|jak pracuję|jak to działa/i.test((s.h2 ?? '') + (s.eyebrow ?? ''))) return 'steps';
  if (items.length) return 'cards';
  return 'prose';
}

// tła: krem i biel na przemian (zrzut i fakty dzielą kremowe tło z bohaterem); cennik ciemny jako akcent
let dark = true; // true = to samo tło co bohater (krem)
const rendered = sections.map((s, i) => {
  const kind = kindOf(s, i);
  if (kind !== 'facts') dark = kind === 'pricing' ? true : !dark;
  if (kind === 'shot') dark = true;
  if (plain) dark = false;
  return { s, kind, dark };
});
---
{rendered.map(({ s, kind, dark }) => {
  if (kind === 'cta') {
    if (ctaMode === 'form') return <ContactSection heading={s.h2} />;
    return (
      <section class="section section--paper sx-cta" id={s.id}>
        <div class="wrap">
          {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
          <h2 class="h2">{s.h2}</h2>
          {(s.intro ?? []).map((p: string) => <p class="lead sx-cta__lead" set:html={p} />)}
          <div class="prose sx-cta__body" set:html={s.before} />
        </div>
      </section>
    );
  }

  if (kind === 'shot') {
    return (
      <section class="sx-shot">
        <div class:list={['wrap', 'sx-shot__grid', { 'sx-shot__grid--two': s.images.length > 1 }]}>
          {s.images.map((img: any, n: number) => (
            <figure class="sx-shot__frame">
              <div class="sx-shot__bar" aria-hidden="true"><i></i><i></i><i></i>{s.url && n === 0 && <span>{s.url}</span>}</div>
              <img src={img.src} alt={img.alt} loading={n === 0 ? 'eager' : 'lazy'} />
            </figure>
          ))}
        </div>
      </section>
    );
  }

  if (kind === 'facts') {
    return (
      <section class="sx-facts">
        <dl class="wrap sx-facts__grid">
          {s.facts.map((f: any) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
        </dl>
      </section>
    );
  }

  const tone = kind === 'pricing' ? 'section--dark' : dark ? 'section--paper' : 'section--white';
  const proseCls = 'prose';
  const sideIntro = (s.intro ?? []).length > 0;

  return (
    <section class:list={['section', tone, `sx-${kind}`, { 'sx-plain': plain }]} id={s.id}>
      <div class="wrap">
        {(s.h2 || s.eyebrow) && <div class:list={['sec-head', { 'sec-head--solo': !sideIntro }]}>
          <div>
            {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
            {s.h2 && <h2 class="h2">{s.h2}</h2>}
          </div>
          {sideIntro && <div class="lead sx-intro">{s.intro.map((p: string) => <p set:html={p} />)}</div>}
        </div>}

        {s.before && kind !== 'faq' && <div class:list={[proseCls, 'sx-before', { 'sx-before--wide': !s.items }]} set:html={s.before} />}

        {kind === 'faq' && (
          <div class="sx-faq">
            <Faq items={s.items.map((it: any) => ({ q: it.title, a: it.html }))} />
          </div>
        )}

        {kind === 'pricing' && s.plans === 'web' && (
          <>
            <ul class="sx-plans">
              {webPlans.map((p) => (
                <PlanCard name={p.name} note={p.note} who={p.who} amount={p.amount} unit={p.unit} time={p.time} items={p.items} cta={p.cta} href="/wycena.html" featured={p.featured} />
              ))}
            </ul>
            <p class="sx-plans__extra">{hourlyRate.label}: <strong>{hourlyRate.amount}</strong>. {pricingNote}</p>
          </>
        )}

        {kind === 'pricing' && s.plans !== 'web' && (
          <ul class="sx-plans">
            {s.items.map((it: any) => (
              <PlanCard name={it.title} note={it.price.note} amount={it.price.amount} unit={it.price.unit} items={it.price.list} cta={it.price.cta} href={it.href ?? '#kontakt'} featured={it.price.featured} />
            ))}
          </ul>
        )}

        {kind === 'projects' && (
          <ul class="sx-projects">
            {s.items.map((it: any) => (
              <li>
                <a class="sx-project" href={it.href}>
                  <div class="sx-project__img"><img src={it.img.src} alt={it.img.alt} loading="lazy" /></div>
                  <h3>{it.title} <Icon name="arrow-up-right" size={20} /></h3>
                  <div class="sx-project__text" set:html={it.html} />
                </a>
              </li>
            ))}
          </ul>
        )}

        {kind === 'links' && (
          <ul class="sx-links">
            {s.items.map((it: any) => (
              <li>
                <a class="sx-link" href={it.href}>
                  <h3>{it.title}</h3>
                  <div class="sx-link__text" set:html={it.html} />
                  <span class="sx-link__more">{s.moreLabel ?? 'Czytaj'} <Icon name="arrow" size={16} /></span>
                </a>
              </li>
            ))}
          </ul>
        )}

        {(kind === 'cards' || kind === 'steps') && (
          <ol class:list={['sx-cards', { 'sx-cards--steps': kind === 'steps', 'sx-cards--many': s.items.length > 4 && s.items.length % 3 === 0, 'sx-cards--3-2': s.layout === '3-2' }]}>
            {s.items.map((it: any, n: number) => (
              <li class="sx-card">
                {kind === 'steps' ? <span class="sx-card__no" aria-hidden="true">{String(n + 1).padStart(2, '0')}</span> : null}
                <h3>{it.title}</h3>
                <div class:list={[proseCls, 'sx-card__body']} set:html={it.html} />
                {it.href && !it.href.startsWith('/#') && <a class="link" href={it.href}>Szczegóły <Icon name="arrow" size={16} /></a>}
              </li>
            ))}
          </ol>
        )}

        {s.after && <div class:list={[proseCls, 'sx-after', { 'sx-after--wide': s.afterWide }]} set:html={s.after} />}
      </div>
    </section>
  );
})}

<style>
  .sec-head--solo { grid-template-columns: minmax(0, 1fr) !important; }
  .sec-head--solo .h2 { max-width: 22ch; }
  .sx-intro p + p { margin-top: 12px; }
  .sx-intro :global(a) { color: inherit; }
  .sx-before { max-width: 760px; }
  .sx-plain .sx-before { max-width: 720px; margin-inline: auto; }
  .sx-before + * { margin-top: 48px; }
  .sx-after { margin-top: 40px; max-width: 760px; }
  .sx-after--wide { max-width: none; }

  /* tabela oferty (program partnerski) */
  .sx-after :global(.sx-offer) { display: table; table-layout: fixed; border: 1px solid var(--line); border-radius: var(--r-lg); border-collapse: separate; border-spacing: 0; overflow: hidden; background: var(--card); font-size: 1rem; line-height: 1.5; }
  .sx-after :global(.sx-offer th), .sx-after :global(.sx-offer td) { padding: 18px 22px; }
  .sx-after :global(.sx-offer tbody tr:last-child > *) { border-bottom: 0; }
  .sx-after :global(.sx-offer tbody th) { background: none; }
  .sx-after :global(.sx-offer td p + p) { margin-top: 10px; }
  .sx-after :global(.sx-offer td strong) { color: var(--rose-strong); font-size: 1.15rem; }
  @media (max-width: 720px) {
    .sx-after :global(.sx-offer), .sx-after :global(.sx-offer tbody), .sx-after :global(.sx-offer tr), .sx-after :global(.sx-offer tbody th), .sx-after :global(.sx-offer td) { display: block; width: 100%; }
    .sx-after :global(.sx-offer thead) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .sx-after :global(.sx-offer tbody tr) { padding: 20px; border-bottom: 1px solid var(--line); }
    .sx-after :global(.sx-offer tbody tr:last-child) { border-bottom: 0; }
    .sx-after :global(.sx-offer tbody th), .sx-after :global(.sx-offer td) { padding: 0; border-bottom: 0; }
    .sx-after :global(.sx-offer td) { margin-top: 12px; }
    .sx-after :global(.sx-offer td::before) { content: attr(data-label); display: block; font-size: var(--t-label); font-weight: 540; color: var(--ink-muted); }
  }

  /* karty */
  .sx-cards { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  @media (min-width: 1000px) { .sx-cards--many { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1000px) {
    .sx-cards--3-2 { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .sx-cards--3-2 > .sx-card { grid-column: span 2; }
    .sx-cards--3-2 > .sx-card:nth-child(n + 4) { grid-column: span 3; }
  }
  .sx-card {
    display: flex; flex-direction: column; gap: 12px; padding: clamp(24px, 2.4vw, 32px);
    border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--card);
    transition: transform .3s var(--ease), box-shadow .3s var(--ease), border-color .3s var(--ease);
  }
  .sx-card:hover { transform: translateY(-2px); box-shadow: 0 24px 48px -32px rgb(26 21 19 / 0.35); }
  .section--dark .sx-card { background: var(--bg); border-color: var(--line); }
  .section--dark .sx-card:hover { border-color: var(--line-strong); box-shadow: none; }
  .sx-card h3 { font-size: var(--t-h3); }
  .sx-card__body { font-size: 1rem; line-height: 1.65; color: var(--ink-muted); }
  .section--dark .sx-card__body { color: var(--fg-muted); }
  .sx-card__body > :global(* + *) { margin-top: 0.7em; }
  .sx-card__body :global(.sx-stat) { font-size: clamp(2.25rem, 1.9rem + 1.4vw, 3rem); font-weight: 640; letter-spacing: -0.03em; line-height: 1.05; color: var(--rose-strong); }
  .sx-card .link { margin-top: auto; }

  .sx-cards--steps { counter-reset: s; }
  .sx-cards--steps .sx-card { border-radius: 0; border: 0; border-top: 1px solid var(--line-light); background: transparent; padding: 28px 0 0; position: relative; }
  .section--dark .sx-cards--steps .sx-card { border-top-color: var(--line); background: transparent; }
  .sx-cards--steps .sx-card::before { content: ''; position: absolute; top: -1px; left: 0; width: 48px; height: 2px; background: var(--rose); transition: width .5s var(--ease); }
  .sx-cards--steps .sx-card:hover { transform: none; box-shadow: none; }
  .sx-cards--steps .sx-card:hover::before { width: 100%; }
  .sx-card__no { font-size: clamp(2.3rem, 2rem + 1.2vw, 3.2rem); font-weight: 640; letter-spacing: -0.04em; line-height: 1; color: transparent; -webkit-text-stroke: 1px var(--rose); margin-bottom: 12px; }
  .section--dark .sx-card__no { -webkit-text-stroke-color: rgb(253 164 175 / 0.6); }

  /* cennik */
  .sx-plans__extra { margin-top: 28px; color: var(--fg-muted); text-align: center; }
  .sx-plans__extra strong { color: var(--fg); font-weight: 620; }
  .sx-plans { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }

  /* faq */
  div.sx-faq { max-width: 900px; }

  /* projekty */
  .sx-projects { display: grid; gap: 40px 24px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .sx-project { display: flex; flex-direction: column; gap: 10px; text-decoration: none; }
  .sx-project__img { aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--r-md); border: 1px solid var(--line-light); margin-bottom: 10px; }
  .sx-project__img img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .6s var(--ease); }
  .sx-project:hover .sx-project__img img { transform: scale(1.03); }
  .sx-project h3 { font-size: var(--t-h3); display: flex; gap: 8px; align-items: center; }
  .sx-project h3 :global(svg) { color: var(--rose-strong); transition: transform .25s var(--ease); }
  .sx-project:hover h3 :global(svg) { transform: translate(3px, -3px); }
  .sx-project__text { color: var(--ink-muted); }

  /* linki do artykułów */
  .sx-links { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .sx-links > li { display: flex; }
  .sx-link {
    flex: 1; display: flex; flex-direction: column; gap: 12px; padding: clamp(24px, 2.4vw, 32px); text-decoration: none;
    border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--card);
    transition: transform .3s var(--ease), border-color .3s var(--ease);
  }
  .section--dark .sx-link { background: var(--bg); border-color: var(--line); }
  .sx-link:hover { transform: translateY(-2px); border-color: var(--rose); }
  .sx-link h3 { font-size: var(--t-h3); }
  .sx-link__text { color: var(--ink-muted); display: grid; gap: 8px; }
  .section--dark .sx-link__text { color: var(--fg-muted); }
  .sx-link__text :global(p:first-child:not(:only-child)) { order: -1; font-size: var(--t-label); font-weight: 580; color: var(--rose-strong); }
  .section--dark .sx-link__text :global(p:first-child:not(:only-child)) { color: var(--accent-fg); }
  .sx-link__more { margin-top: auto; padding-top: 8px; display: inline-flex; align-items: center; gap: 8px; font-weight: 580; color: var(--rose-strong); }
  .section--dark .sx-link__more { color: var(--accent-fg); }
  .sx-link__more :global(svg) { transition: transform .25s var(--ease); }
  .sx-link:hover .sx-link__more :global(svg) { transform: translateX(4px); }

  /* zrzut ekranu (case study) */
  .sx-shot { background: var(--paper); padding-bottom: clamp(48px, 5vw, 80px); }
  .sx-shot__grid { display: grid; gap: 24px; }
  @media (min-width: 900px) { .sx-shot__grid--two { grid-template-columns: 1fr 1fr; align-items: start; } }
  .sx-shot__frame { margin: 0; border-radius: 14px; overflow: hidden; background: #231e1b; border: 1px solid rgb(255 255 255 / 0.12); box-shadow: 0 40px 80px -36px rgb(26 21 19 / 0.4); }
  .sx-shot__bar { display: flex; align-items: center; gap: 6px; height: 34px; padding: 0 12px; }
  .sx-shot__bar i { width: 9px; height: 9px; border-radius: 50%; background: rgb(255 255 255 / 0.18); }
  .sx-shot__bar i:first-child { background: var(--rose); }
  .sx-shot__bar span { margin-left: auto; margin-right: auto; padding: 0 12px; height: 20px; line-height: 20px; border-radius: 6px; background: rgb(255 255 255 / 0.07); color: rgb(255 255 255 / 0.6); font-size: 11px; }
  .sx-shot__frame img { width: 100%; max-height: 760px; object-fit: cover; object-position: top; background: #fff; }

  /* fakty (case study) */
  .sx-facts { background: var(--paper); padding-bottom: clamp(56px, 6vw, 96px); }
  .sx-facts__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); border-top: 1px solid var(--line); margin-block: 0; }
  .sx-facts__grid > div { padding: 24px 24px 0 0; }
  .sx-facts__grid dt { font-size: var(--t-label); color: var(--fg-muted); font-weight: 540; }
  .sx-facts__grid dd { margin: 6px 0 0; font-size: 1.15rem; font-weight: 580; letter-spacing: -0.01em; }

  .sx-cta__lead { margin-top: 20px; }
  .sx-cta__body { margin-top: 28px; }
</style>
