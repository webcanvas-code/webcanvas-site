---
import { Image } from 'astro:assets';
import logo from '../assets/logo-dark.png';
import Icon from './Icon.astro';
import { mainNav, company } from '../data/site';

// numer bez prefiksu kraju, czytelniejszy w nagłówku
const phoneShort = company.phone.replace(/^\+48\s*/, '');

const current = Astro.url.pathname;
---
<header class="nav" data-nav>
  <div class="wrap nav__bar">
    <a class="nav__logo" href="/" aria-label="WebCanvas, strona główna">
      <Image src={logo} alt="" width={160} height={35} loading="eager" />
    </a>

    <nav class="nav__links" aria-label="Główna nawigacja">
      <ul>
        {mainNav.map((item) => item.children ? (
          <li class="nav__dd" data-dd>
            <a href={item.href} aria-haspopup="true" aria-expanded="false" data-dd-trigger>
              {item.label}
              <svg class="nav__chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <ul class="nav__menu">
              {item.children.map((c) => (
                <li><a href={c.href} aria-current={current === c.href ? 'page' : undefined}>{c.label}</a></li>
              ))}
            </ul>
          </li>
        ) : (
          <li>
            <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav__actions">
      <a class="nav__phone" href={company.phoneHref} data-track="header" aria-label={`Zadzwoń: ${company.phone}`}>
        <Icon name="phone" size={18} />
        <span class="nav__phone-num">{phoneShort}</span>
      </a>
      <a class="btn btn--primary nav__cta" href="/wycena.html">Wyceń projekt</a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu-mobilne" aria-label="Otwórz menu" data-nav-toggle>
        <Icon name="menu" size={22} class="i-open" />
        <Icon name="close" size={22} class="i-close" />
      </button>
    </div>
  </div>

  <div class="nav__sheet" id="menu-mobilne" hidden data-nav-sheet>
    <ul class="wrap">
      {mainNav.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
          {item.children && (
            <ul class="nav__sub">
              {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
            </ul>
          )}
        </li>
      ))}
      <li><a href="/#kontakt">Kontakt</a></li>
    </ul>
    <div class="wrap nav__sheet-cta">
      <a class="btn btn--primary" href="/wycena.html">Wyceń projekt <Icon name="arrow" /></a>
      <a class="btn btn--ghost nav__sheet-call" href={company.phoneHref} data-track="menu"><Icon name="phone" /> Zadzwoń: {company.phone}</a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const sheet = document.querySelector<HTMLElement>('[data-nav-sheet]');

  const setOpen = (open: boolean) => {
    if (!toggle || !sheet || !nav) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
    sheet.hidden = !open;
    nav.classList.toggle('is-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  sheet?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  window.matchMedia('(min-width: 960px)').addEventListener('change', (m) => { if (m.matches) setOpen(false); });

  // rozwijane menu „Usługi”: hover/focus w CSS, tu dotyk i klawiatura
  document.querySelectorAll<HTMLElement>('[data-dd]').forEach((dd) => {
    const trigger = dd.querySelector<HTMLAnchorElement>('[data-dd-trigger]');
    const set = (open: boolean) => {
      dd.classList.toggle('is-open', open);
      trigger?.setAttribute('aria-expanded', String(open));
    };
    dd.addEventListener('mouseenter', () => set(true));
    dd.addEventListener('mouseleave', () => set(false));
    dd.addEventListener('focusout', (e) => { if (!dd.contains(e.relatedTarget as Node)) set(false); });
    // pierwsze stuknięcie na ekranie dotykowym otwiera listę zamiast przechodzić do sekcji
    trigger?.addEventListener('click', (e) => {
      if (window.matchMedia('(hover: none)').matches && !dd.classList.contains('is-open')) {
        e.preventDefault();
        set(true);
      }
    });
    trigger?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); set(true); dd.querySelector<HTMLAnchorElement>('.nav__menu a')?.focus(); }
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && dd.classList.contains('is-open')) { set(false); trigger?.focus(); } });
    document.addEventListener('click', (e) => { if (!dd.contains(e.target as Node)) set(false); });
  });

  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid transparent;
    transition: border-color .25s var(--ease);
  }
  /* Rozmycie tła na pseudo-elemencie: backdrop-filter na samym .nav tworzy blok
     zawierający dla position: fixed, przez co panel menu mobilnego był przycinany
     do wysokości nagłówka i przykrywała go sekcja Hero. */
  .nav::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: rgb(255 253 250 / 0.9);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }
  .nav.is-open::before { background: var(--bg); }
  .nav.is-scrolled, .nav.is-open { border-bottom-color: var(--line); }
  .nav__bar { height: var(--nav-h); display: flex; align-items: center; gap: 24px; }
  .nav__logo { display: block; flex: none; margin-right: auto; padding: 6px 0; }
  .nav__logo img { width: 150px; height: auto; }

  .nav__links ul { display: flex; gap: 4px; }
  .nav__links a {
    display: block; padding: 10px 14px; border-radius: 999px;
    font-size: 0.95rem; font-weight: 500; color: var(--fg-muted); text-decoration: none;
    transition: color .2s var(--ease), background-color .2s var(--ease);
  }
  .nav__links a:hover { color: var(--fg); background: var(--tint); }
  .nav__links a[aria-current='page'] { color: var(--fg); }

  .nav__dd { position: relative; }
  .nav__dd > a { display: inline-flex; align-items: center; gap: 6px; }
  .nav__chev { transition: transform .2s var(--ease); }
  .nav__dd.is-open .nav__chev, .nav__dd:focus-within .nav__chev { transform: rotate(180deg); }
  .nav__links .nav__menu {
    position: absolute; top: 100%; left: 0; min-width: 250px;
    display: block; padding: 8px; margin-top: 6px;
    background: var(--white, #fff); border: 1px solid var(--line); border-radius: 16px;
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.25);
    opacity: 0; visibility: hidden; transform: translateY(-4px);
    transition: opacity .18s var(--ease), transform .18s var(--ease), visibility .18s;
  }
  /* mostek, żeby kursor nie gubił menu w szczelinie pod przyciskiem */
  .nav__links .nav__menu::before { content: ''; position: absolute; left: 0; right: 0; top: -10px; height: 10px; }
  .nav__dd.is-open .nav__menu, .nav__dd:focus-within .nav__menu { opacity: 1; visibility: visible; transform: none; }
  .nav__links .nav__menu a { border-radius: 10px; padding: 10px 12px; color: var(--fg); white-space: nowrap; }
  .nav__links .nav__menu a[aria-current='page'] { color: var(--rose); }

  .nav__actions { display: flex; align-items: center; gap: 10px; }
  .nav__cta { --bh: 46px; padding-inline: 22px; }
  .nav__phone {
    display: inline-flex; align-items: center; gap: 8px; height: 46px; padding: 0 14px;
    border-radius: 999px; color: var(--fg); font-weight: 600; font-size: 0.98rem;
    text-decoration: none; white-space: nowrap; font-variant-numeric: tabular-nums;
    transition: background-color .2s var(--ease), color .2s var(--ease);
  }
  .nav__phone:hover { background: var(--tint); color: var(--rose); }
  .nav__phone :global(svg) { flex: none; color: var(--rose); }
  .nav__sheet-call { margin-top: 12px; }
  .nav__toggle {
    display: none; width: 46px; height: 46px; border-radius: 999px;
    border: 1px solid var(--line-strong); background: transparent; cursor: pointer;
    align-items: center; justify-content: center;
  }
  .nav__toggle :global(.i-close) { display: none; }
  .nav.is-open .nav__toggle :global(.i-open) { display: none; }
  .nav.is-open .nav__toggle :global(.i-close) { display: block; }

  .nav__sheet {
    position: fixed; inset: var(--nav-h) 0 0; background: var(--bg);
    overflow-y: auto; padding: 16px 0 32px;
  }
  .nav__sheet ul a {
    display: flex; align-items: center; min-height: 60px;
    border-bottom: 1px solid var(--line);
    font-size: 1.5rem; font-weight: 600; letter-spacing: -0.02em; text-decoration: none;
  }
  .nav__sheet ul.nav__sub { padding: 4px 0 8px 16px; border-bottom: 1px solid var(--line); }
  .nav__sheet ul.nav__sub a {
    min-height: 44px; border-bottom: 0;
    font-size: 1.05rem; font-weight: 500; letter-spacing: 0; color: var(--fg-muted);
  }
  .nav__sheet-cta { margin-top: 28px; }
  .nav__sheet-cta .btn { width: 100%; }

  @media (max-width: 1080px) and (min-width: 960px) {
    .nav__links a { padding-inline: 10px; }
  }
  @media (max-width: 959px) {
    .nav__links { display: none; }
    .nav__toggle { display: inline-flex; }
  }
  @media (max-width: 640px) {
    /* na telefonie sama ikona: okrągły przycisk jak przełącznik menu */
    .nav__phone { width: 46px; padding: 0; justify-content: center; border: 1px solid var(--line-strong); }
    .nav__phone-num { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (max-width: 480px) {
    .nav__cta { display: none; }
    .nav__logo img { width: 136px; }
  }
</style>
