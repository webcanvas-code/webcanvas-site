  }
  .toc__btn:disabled { cursor: default; }
  .toc__btn:not(:disabled):hover { background: rgb(26 21 19 / 0.05); }
  .toc__num { font-size: 1.05rem; font-weight: 700; color: rgb(26 21 19 / 0.32); font-variant-numeric: tabular-nums; line-height: 1.5; transition: color .25s; }
  .toc__title { display: block; font-weight: 620; color: var(--ink); }
