---
import { Image } from 'astro:assets';
import portrait from '../assets/adam-kubiak.png';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BrowserFrame from '../components/BrowserFrame.astro';
import ContactSection from '../components/ContactSection.astro';
import { company, reviews, faq } from '../data/site';
import { projects } from '../data/projects';

const [featured, ...rest] = projects.filter((p) => p.home !== false);
const byName = Object.fromEntries(projects.map((p) => [p.name, p]));

const services = [
  { icon: 'browser', title: 'Strony internetowe', text: 'Strony firmowe, wizytówki i landing page, które jasno pokazują ofertę i prowadzą klienta do kontaktu.', tags: ['WordPress', 'Landing page', 'SEO'], href: '/tworzenie-stron-internetowych.html' },
  { icon: 'cart', title: 'Sklepy internetowe', text: 'Sklepy na WooCommerce z płatnościami online, wygodnym koszykiem i panelem, który obsłużysz bez programisty.', tags: ['WooCommerce', 'Płatności online'] },
  { icon: 'app', title: 'Aplikacje webowe', text: 'Panele klienta, dashboardy i systemy B2B / B2C, które porządkują procesy w firmie.', tags: ['B2B / B2C', 'Dashboard'] },
  { icon: 'pen', title: 'Projekt graficzny', text: 'Układ i wygląd zaprojektowane pod Twoją markę i klientów, bez gotowych szablonów.', tags: ['UI / UX', 'Identyfikacja'] },
  { icon: 'search', title: 'Pozycjonowanie SEO', text: 'Audyt techniczny, treści, linki i lokalne SEO, żeby klienci z okolicy znajdowali Cię w Google.', tags: ['Audyt SEO', 'Local SEO'], href: '/pozycjonowanie-seo.html' },
  { icon: 'target', title: 'Kampanie Google Ads', text: 'Reklamy w wyszukiwarce, sieci reklamowej i Zakupach, widoczne w chwili, gdy klient szuka usługi.', tags: ['Search', 'Remarketing'], href: '/kampanie-google-ads.html' },
  { icon: 'megaphone', title: 'Kampanie Meta Ads', text: 'Reklamy na Facebooku i Instagramie z precyzyjnym targetowaniem, kreacjami i formularzami leadowymi.', tags: ['Facebook', 'Instagram'], href: '/kampanie-meta-ads.html' },
  { icon: 'server', title: 'Hosting i domena', text: 'Szybki serwer, certyfikat SSL, domena i firmowa poczta e-mail skonfigurowane za Ciebie.', tags: ['SSL', 'E-mail firmowy'] },
  { icon: 'support', title: 'Szkolenie i opieka', text: 'Szkolenie z panelu CMS, instrukcje i opieka techniczna po starcie strony.', tags: ['CMS', 'Opieka'] },
];

const principles = [
  { title: 'Rozmawiasz ze mną', text: 'Od wyceny po publikację masz jedną osobę do kontaktu, która zna cały projekt i za niego odpowiada.' },
  { title: 'Projekt pod Twoją firmę', text: 'Nie składam strony z gotowego szablonu. Układ i grafika powstają pod Twoją ofertę i Twoich klientów.' },
  { title: 'SEO od pierwszego dnia', text: 'Szybkie ładowanie, poprawna struktura nagłówków i lokalne SEO są w każdym projekcie, nie jako dopłata.' },
  { title: 'Opieka po starcie', text: 'Uczę obsługi panelu, dbam o hosting i zostaję pod telefonem, kiedy trzeba coś zmienić albo dodać.' },
];

const steps = [
  { title: 'Rozmowa i wycena', text: 'Mówisz, co robi Twoja firma i czego oczekujesz od strony. W ciągu 24 godzin dostajesz wycenę i plan prac.' },
  { title: 'Projekt graficzny', text: 'Przygotowuję układ i wygląd. Oglądasz go na żywo i zgłaszasz uwagi, zanim zacznę kodować.' },
  { title: 'Wdrożenie', text: 'Koduję stronę, wgrywam treści, ustawiam SEO, analitykę i formularze. Sprawdzam ją na telefonach i komputerach.' },
  { title: 'Start i opieka', text: 'Publikuję stronę, pokazuję, jak ją edytować, i pomagam, kiedy firma rośnie.' },
];

const plans = [
  {
    name: 'Pakiet Pro', note: 'Dla firm, które potrzebują solidnego startu w sieci.',
    price: 'od 3000', unit: 'PLN netto',
    items: ['Strona one-page lub landing page', 'Wygląd dopasowany do telefonów', 'Podstawowa optymalizacja SEO', 'Konfiguracja domeny i hostingu'],
    cta: 'Wybieram Pro',
  },
  {
    name: 'Pakiet Unique', note: 'Rozbudowana strona firmowa albo sklep internetowy.',
    price: 'od 4000', unit: 'PLN netto', featured: true,
    items: ['Indywidualny projekt graficzny', 'System CMS albo sklep e-commerce', 'Dopracowane animacje', 'Szkolenie z obsługi panelu'],
    cta: 'Wybieram Unique',
  },
  {
    name: 'Pakiet godzinowy', note: 'Rozwój i poprawki istniejących stron.',
    price: '200', unit: 'PLN / h netto',
    items: ['Audyt i optymalizacja kodu', 'Nowe funkcje', 'Naprawa błędów', 'Konsultacje technologiczne'],
    cta: 'Zapytaj o termin',
  },
];

const posts = [
  { tag: 'Wycena', title: 'Ile kosztuje strona internetowa dla małej firmy?', text: 'Realne ceny stron www w 2026 roku, od wizytówki po sklep, i to, co na nie wpływa.', time: '5 min', href: '/blog-ile-kosztuje-strona-internetowa.html' },
  { tag: 'UX', title: '5 sygnałów, że Twoja stara strona odstrasza klientów', text: 'Po czym poznać, że strona traci zapytania i co poprawić w pierwszej kolejności.', time: '6 min', href: '/blog-stara-strona-internetowa-sygnaly.html' },
  { tag: 'Proces', title: 'Jak wygląda proces zamawiania strony krok po kroku', text: 'Od pierwszej rozmowy do wdrożenia: co dzieje się na każdym etapie współpracy.', time: '5 min', href: '/blog-proces-tworzenia-strony-internetowej.html' },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': 'https://web-canvas.pl/#business',
    name: 'WebCanvas',
    url: 'https://web-canvas.pl/',
    logo: 'https://web-canvas.pl/img/logo.png',
    hasMap: company.googleReviews,
    openingHoursSpecification: [
      { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '17:00' },
    ],
    description: 'WebCanvas projektuje i wdraża nowoczesne strony internetowe oraz sklepy e-commerce dla firm z całej Polski. Pracujemy zdalnie, obsługując klientów z całego kraju.',
    email: company.email,
    telephone: '+48739043596',
    image: 'https://web-canvas.pl/img/og-image.png',
    areaServed: [
      { '@type': 'City', name: 'Konin' },
      { '@type': 'City', name: 'Turek' },
      { '@type': 'City', name: 'Koło' },
      { '@type': 'City', name: 'Słupca' },
      { '@type': 'City', name: 'Poznań' },
      { '@type': 'City', name: 'Sompolno' },
      { '@type': 'AdministrativeArea', name: 'Wielkopolska' },
    ],
    sameAs: [company.socials.facebook, company.socials.instagram, company.googleReviews],
    priceRange: 'od 3000 PLN',
    address: { '@type': 'PostalAddress', streetAddress: company.street, addressLocality: company.city, postalCode: company.postalCode, addressCountry: 'PL' },
    aggregateRating: { '@type': 'AggregateRating', ratingValue: '5.0', reviewCount: String(company.reviewCount) },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base
  title="Tworzenie stron internetowych dla firm | WebCanvas"
  description="Projektujemy i wdrażamy nowoczesne strony internetowe oraz sklepy e-commerce dla firm z całej Polski. Szybkie wdrożenia, SEO od pierwszego dnia i wsparcie po starcie."
  ogTitle="WebCanvas | Projektowanie i tworzenie stron internetowych"
  path="/"
  schema={schema}
>
  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap hero__text" data-enter>
      <h1 id="hero-h">Strony internetowe dla firm, <span>które zdobywają klientów.</span></h1>
      <p class="hero__lead">Tworzę strony, sklepy i kampanie dla małych i średnich firm. Jasna oferta, szybkie ładowanie i SEO od pierwszego dnia.</p>
      <div class="btn-row hero__btns">
        <a class="btn btn--primary" href="#kontakt">Wyceń projekt <Icon name="arrow" /></a>
        <a class="btn btn--ghost" href="#realizacje">Zobacz realizacje</a>
      </div>
      <ul class="hero__facts">
        <li><a href={company.googleReviews} target="_blank" rel="noopener"><span class="stars" aria-hidden="true">{[1,2,3,4,5].map(() => <Icon name="star" size={15} />)}</span><strong>{company.rating}</strong> w Google · {company.reviewCount} opinii</a></li>
        <li><Icon name="clock" size={17} />Wycena w 24 godziny</li>
        <li><Icon name="check" size={17} />Strony od 3000 zł netto</li>
      </ul>
    </div>

    <div class="hero__stage">
      <div class="wrap hero__shots" aria-label="Przykładowe strony zaprojektowane przez WebCanvas">
        <BrowserFrame class="shot shot--left" src={byName['Dworzec Autobusowy Poznań'].image} alt={byName['Dworzec Autobusowy Poznań'].alt} url="dworzecautobusowy.poznan.pl" widths={[400, 640]} sizes="(min-width: 1000px) 34vw, 0px" />
        <BrowserFrame class="shot shot--main" src={byName['Meritoros'].image} alt={byName['Meritoros'].alt} url="meritoros.pl" widths={[480, 800, 1100, 1400]} sizes="(min-width: 1000px) 56vw, 92vw" eager />
        <BrowserFrame class="shot shot--right" src={byName['Woodbud'].image} alt={byName['Woodbud'].alt} url="woodbud.pl" widths={[400, 640]} sizes="(min-width: 1000px) 34vw, 0px" />
      </div>
    </div>
  </section>

  <!-- USŁUGI -->
  <section class="section section--white" id="uslugi" aria-labelledby="uslugi-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Usługi</p>
          <h2 class="h2" id="uslugi-h">Od strony po reklamę. <span class="accent">W jednym miejscu.</span></h2>
        </div>
        <p class="lead">Od projektu po kampanie reklamowe. Za całość odpowiada jedna osoba, więc nic nie gubi się po drodze.</p>
      </div>

      <ul class="services">
        {services.map((s, i) => {
          const Tag = s.href ? 'a' : 'div';
          return (
            <li>
              <Tag class:list={['service', { 'service--link': s.href }]} href={s.href}>
                <div class="service__top">
                  <span class="service__icon"><Icon name={s.icon} size={24} /></span>
                  <span class="service__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                </div>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
                <ul class="tags">{s.tags.map((t) => <li>{t}</li>)}</ul>
                {s.href && <span class="service__more">Szczegóły usługi <Icon name="arrow" size={16} /></span>}
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- REALIZACJE -->
  <section class="section section--paper on-light" id="realizacje" aria-labelledby="realizacje-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Realizacje</p>
          <h2 class="h2" id="realizacje-h">Strony, które pracują <span class="accent">na co dzień.</span></h2>
        </div>
        <div class="sec-head__side">
          <p class="lead">Dworzec, kancelaria, stolarnia, gabinet. Każda strona powstała pod konkretny biznes i jego klientów.</p>
          <a class="link" href="/realizacje.html">Wszystkie realizacje <Icon name="arrow" /></a>
        </div>
      </div>

      <a class="feature" href={featured.href}>
        <div class="feature__img">
          <Image src={featured.image} alt={featured.alt} widths={[640, 960, 1400]} sizes="(min-width: 1000px) 60vw, 100vw" />
        </div>
        <div class="feature__body">
          <p class="feature__trade">{featured.trade}</p>
          <h3>{featured.name}</h3>
          <p>{featured.summary}</p>
          <ul class="tags tags--light">{featured.tags.map((t) => <li>{t}</li>)}</ul>
          <span class="link">Przeczytaj case study <Icon name="arrow" /></span>
        </div>
      </a>

      <ul class="work">
        {rest.map((p, i) => (
          <li>
            <a class="work__card" href={p.href}>
              <div class="work__img">
                <Image src={p.image} alt={p.alt} widths={[480, 720, 960, 1280]} sizes={i < 2 ? '(min-width: 1000px) 46vw, (min-width: 640px) 50vw, 100vw' : '(min-width: 1000px) 30vw, (min-width: 640px) 50vw, 100vw'} />
              </div>
              <p class="work__trade">{p.trade}</p>
              <h3>{p.name} <Icon name="arrow-up-right" size={20} /></h3>
              <p class="work__text">{p.summary}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PODEJŚCIE -->
  <section class="section section--white" id="studio" aria-labelledby="studio-h">
    <div class="wrap approach">
      <div>
        <p class="eyebrow">Jak pracuję</p>
        <h2 class="h2" id="studio-h">Jeden kontakt. <span class="accent">Cała odpowiedzialność.</span></h2>
        <p class="lead approach__lead">Pracuję z firmami z Konina, Turku, Koła, Słupcy, Poznania i z całej Polski, zdalnie albo na spotkaniu.</p>
        <div class="portrait">
          <Image src={portrait} alt="Adam Kubiak, WebCanvas" widths={[400, 640, 960]} sizes="(min-width: 1000px) 42vw, 100vw" />
          <div class="portrait__bar theme-dark">
            <div>
              <p class="portrait__name">{company.person}</p>
              <p class="portrait__role">Projekt i wdrożenie</p>
            </div>
            <a class="portrait__rating" href={company.googleReviews} target="_blank" rel="noopener">
              <span class="stars" aria-hidden="true">{[1,2,3,4,5].map(() => <Icon name="star" size={14} />)}</span>
              <strong>{company.rating}</strong> w Google
            </a>
          </div>
        </div>
      </div>
      <ol class="principles">
        {principles.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PROCES -->
  <section class="section section--paper" id="proces" aria-labelledby="proces-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Proces</p>
          <h2 class="h2" id="proces-h">Cztery kroki <span class="accent">do nowej strony.</span></h2>
        </div>
        <p class="lead">Prosta strona powstaje w 7–14 dni roboczych. Sklep albo aplikacja zajmuje zwykle od 3 do 8 tygodni.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="steps__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- OPINIE -->
  <section class="section section--white on-light" id="opinie" aria-labelledby="opinie-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Opinie z Google</p>
          <h2 class="h2" id="opinie-h">Co mówią <span class="accent">klienci.</span></h2>
        </div>
        <div class="sec-head__side">
          <p class="lead"><strong class="rating-inline">{company.rating} / 5</strong> ze wszystkich {company.reviewCount} opinii w profilu firmy w Google.</p>
          <a class="link" href={company.googleReviews} target="_blank" rel="noopener">Zobacz opinie w Google <Icon name="arrow-up-right" /></a>
        </div>
      </div>
      <ul class="reviews">
        {reviews.map((r) => (
          <li class="review">
            <span class="stars" aria-label="Ocena 5 na 5">{[1,2,3,4,5].map(() => <Icon name="star" size={16} />)}</span>
            <blockquote><p>{r.text}</p></blockquote>
            <p class="review__who">
              <span class="review__avatar" aria-hidden="true">{r.name.split(' ').map((w) => w[0]).join('').slice(0, 2)}</span>
              <a href={r.url} target="_blank" rel="noopener">{r.name}</a>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CENNIK -->
  <section class="section section--dark" id="cennik" aria-labelledby="cennik-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Cennik</p>
          <h2 class="h2" id="cennik-h">Przejrzyste ceny <span class="accent">na start.</span></h2>
        </div>
        <p class="lead">Dokładną kwotę podaję po rozmowie, w ciągu 24 godzin. Wszystkie ceny są netto, doliczam VAT 23%.</p>
      </div>
      <ul class="plans">
        {plans.map((p) => (
          <li class:list={['plan', { 'plan--featured': p.featured }]}>
            {p.featured && <span class="plan__badge">Najczęściej wybierany</span>}
            <h3>{p.name}</h3>
            <p class="plan__note">{p.note}</p>
            <p class="plan__price"><strong>{p.price}</strong> <span>{p.unit}</span></p>
            <ul class="plan__items">
              {p.items.map((it) => <li><Icon name="check" size={18} />{it}</li>)}
            </ul>
            <a class:list={['btn', p.featured ? 'btn--primary' : 'btn--ghost']} href="#kontakt">{p.cta}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section section--paper on-light" id="blog" aria-labelledby="blog-h">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Blog</p>
          <h2 class="h2" id="blog-h">Praktycznie o stronach <span class="accent">dla firm.</span></h2>
        </div>
        <div class="sec-head__side">
          <p class="lead">Krótkie poradniki o kosztach, SEO i tym, jak przygotować się do nowej strony.</p>
          <a class="link" href="/blog.html">Wszystkie artykuły <Icon name="arrow" /></a>
        </div>
      </div>
      <ul class="posts">
        {posts.map((p) => (
          <li>
            <a class="post" href={p.href}>
              <p class="post__meta"><span class="post__tag">{p.tag}</span>{p.time} czytania</p>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
              <span class="post__more">Czytaj <Icon name="arrow" size={16} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--white on-light" id="faq" aria-labelledby="faq-h">
    <div class="wrap faq">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 class="h2" id="faq-h">Zanim <span class="accent">napiszesz.</span></h2>
        <p class="lead faq__lead">Nie ma tu Twojego pytania? Zadzwoń: <a class="link" href={company.phoneHref}>{company.phone}</a></p>
      </div>
      <div class="faq__list">
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary><h3>{f.q}</h3><span class="faq__icon" aria-hidden="true"><Icon name="plus" size={20} /></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactSection />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; overflow: hidden; background: var(--paper); --peek: clamp(110px, 16vh, 200px); }
  /* tekst wypełnia pierwszy ekran, z dołu wystaje górna część zrzutów realizacji */
  .hero__text {
    min-height: calc(100vh - var(--nav-h) - var(--peek)); min-height: calc(100svh - var(--nav-h) - var(--peek));
    justify-content: center; padding-block: 48px;
  }
  .hero::before {
    content: ''; position: absolute; inset: -20% 10% auto; height: 70%; pointer-events: none;
    background: radial-gradient(closest-side, rgb(225 29 72 / 0.18), transparent);
    filter: blur(20px);
  }
  .hero__text { position: relative; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .hero h1 {
    margin-top: 0; font-size: clamp(2.5rem, 1.1rem + 4.4vw, 4.9rem); font-weight: 680; letter-spacing: -0.045em; line-height: 1;
    max-width: 20ch;
  }
  .hero h1 span { color: var(--rose); display: block; }
  .hero__lead { margin-top: 28px; font-size: var(--t-lead); color: var(--fg-muted); max-width: 58ch; line-height: 1.55; }
  .hero__btns { margin-top: 36px; justify-content: center; }
  .hero__facts {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 28px; margin-top: 32px;
    font-size: var(--t-small); color: var(--fg-muted);
  }
  .hero__facts li, .hero__facts a { display: inline-flex; align-items: center; gap: 8px; text-decoration: none; }
  .hero__facts a:hover { color: var(--fg); }
  .hero__facts strong { color: var(--fg); font-weight: 620; }
  .hero__facts :global(svg) { color: var(--accent-fg); }
  .stars { display: inline-flex; gap: 2px; color: var(--amber); }
  .hero__facts .stars :global(svg) { color: var(--amber); }

  .hero__stage { position: relative; }
  .hero__stage::after {
    content: ''; position: absolute; inset: 42% 0 0; background: var(--white); z-index: 0;
  }
  .hero__shots { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr; }
  .hero__shots :global(.shot--left), .hero__shots :global(.shot--right) { display: none; }
  @media (min-width: 1000px) {
    .hero__shots { grid-template-columns: 1fr 2.2fr 1fr; align-items: end; }
    .hero__shots :global(.shot--main) { grid-column: 2; grid-row: 1; position: relative; z-index: 2; }
    .hero__shots :global(.shot--left), .hero__shots :global(.shot--right) {
      display: block; grid-row: 1; margin-bottom: 48px; opacity: 0.9;
      transition: transform .5s var(--ease), opacity .3s var(--ease);
    }
