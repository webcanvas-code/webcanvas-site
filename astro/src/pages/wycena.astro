  .toc__edit { display: none; font-size: var(--t-small); font-weight: 580; color: var(--rose-strong); line-height: 1.5; }
  .is-current .toc__btn { background: var(--paper); box-shadow: 0 1px 2px rgb(26 21 19 / 0.08); }
