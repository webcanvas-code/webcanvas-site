  .tile:has(input:checked) { border-color: var(--rose); box-shadow: 0 0 0 1px var(--rose); }
  .tile:has(input:checked) .tile__icon { background: var(--rose); color: #fff; }
  .tile:has(input:focus-visible) { outline: 2px solid var(--rose); outline-offset: 3px; }

  /* odpowiedzi jako "pigułki" */
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .chip span {
    display: inline-flex; align-items: center; min-height: 44px; padding: 8px 18px; border-radius: 999px;
    background: var(--white); border: 1px solid var(--line-light); font-weight: 520; line-height: 1.3;
    transition: background-color .2s var(--ease), border-color .2s var(--ease), color .2s var(--ease);
  }
  .chip:hover span { border-color: rgb(26 21 19 / 0.32); }
  .chip input:checked + span { background: var(--ink); border-color: var(--ink); color: var(--white); }
  .chip input:focus-visible + span { outline: 2px solid var(--rose); outline-offset: 2px; }

  .input {
    width: 100%; min-height: 50px; padding: 12px 16px;
    font: inherit; font-size: 16px; color: var(--ink);
    background: var(--white); border: 1px solid var(--line-light); border-radius: var(--r-sm);
    transition: border-color .2s var(--ease), box-shadow .2s var(--ease);
  }
  textarea.input { resize: vertical; min-height: 110px; }
  .input:hover { border-color: rgb(26 21 19 / 0.3); }
  .input:focus { outline: none; border-color: var(--rose); box-shadow: 0 0 0 3px rgb(225 29 72 / 0.18); }
  .input[aria-invalid] { border-color: var(--rose-strong); }

  .wz__row { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
